<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>springboot-admin-demo</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>springboot-admin-demo</name>
    <description>Spring Boot 3 整合 Spring Boot Admin 实战教程：Server + Client 双应用</description>

    <modules>
        <module>admin-server</module>
        <module>admin-client</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- Spring Boot Admin 3.5.x 线适配 Spring Boot 3.5.x；4.x 基于 Spring Boot 4，勿在 Boot 3 项目使用 -->
        <spring-boot-admin.version>3.5.11</spring-boot-admin.version>
    </properties>
</project>
